{
  "name": "little-gate-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "rsbuild",
    "build": "npm run ui:check && npm run email-templates:check && tsc -b && rsbuild build",
    "email-templates:generate": "node scripts/render-notification-email.mjs --write",
    "email-templates:check": "node scripts/render-notification-email.mjs --check",
    "test": "rstest run",
    "ui:check": "node scripts/check-console-ui.mjs"
  },
  "dependencies": {
