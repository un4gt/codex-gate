    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.2.0",
    "@mui/x-charts": "~9.14.0",
    "decimal.js-light": "^2.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.5",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/core": "^0.11.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "emailmd": "0.10.0",
    "jsdom": "^29.1.1",
    "react-compiler-runtime": "^1.0.0",
    "typescript": "^5.6.3"
  }
